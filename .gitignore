node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
*.local

# Base de données locale libSQL (bind-mount, ne jamais committer)
/data/*.db
/data/*.db-*

# Certificats locaux (mkcert)
/certs/*.pem

# Données importées (régénérables via les scripts data:*).
# On versionne les sorties finales légères pour un déploiement clé en main :
# - rail-lines.geojson (~1,7 Mo) : tracés SNCF simplifiés
# - arcep-coverage.geojson (~3,2 Mo) : couverture ARCEP échantillonnée le long des voies
# Les fichiers temporaires lourds (.gpkg, .7z) restent hors du dépôt.
/static/data/*.gpkg
/static/data/*.7z
!/static/data/.gitkeep
!/static/data/rail-lines.geojson
!/static/data/arcep-coverage.geojson

.DS_Store
