# Toutes ces variables sont déclarées (et validées au démarrage) dans src/env.ts
# (SvelteKit 3 : $app/env/private et $app/env/public). Toutes sont facultatives et
# lues au démarrage du serveur, pas figées au build.

# --- Base de données (libSQL / Turso) ---
# Par défaut : fichier libSQL local sur le serveur perso (bind-mount ./data).
DATABASE_URL="file:./data/local.db"
# Pour Turso cloud, remplacer par :
# DATABASE_URL="libsql://<db>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<token>"

# --- Public (exposé au client, préfixe PUBLIC_) ---
# URL de base du site, source unique des liens absolus : canonical, sitemap,
# og:url et og:image (vignettes sociales). Lue via src/lib/site.ts, avec repli sur
# l'URL de prod si absente (donc un build sans cette variable reste correct).
# Pages prérendues (sitemap, /lignes, /operateurs, FAQ…) : valeur lue AU BUILD.
PUBLIC_SITE_URL="http://localhost:5173"

# --- Anti-abus ---
# Nombre max de mesures acceptées par session et par minute (défaut 120 ; une valeur
# qui n'est pas un entier > 0 empêche le serveur de démarrer).
INGEST_RATE_LIMIT="120"
