# --- Base de données (libSQL / Turso) ---
# Par défaut : fichier libSQL local sur le serveur perso (bind-mount ./data).
DATABASE_URL="file:./data/local.db"
# Pour Turso cloud, remplacer par :
# DATABASE_URL="libsql://<db>-<org>.turso.io"
# DATABASE_AUTH_TOKEN="<token>"

# --- Public (exposé au client, préfixe PUBLIC_) ---
# URL de base du site, utilisée pour les balises SEO / sitemap.
PUBLIC_SITE_URL="http://localhost:5173"

# --- Anti-abus ---
# Nombre max de mesures acceptées par session et par minute.
INGEST_RATE_LIMIT="120"
