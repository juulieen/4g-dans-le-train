{
	"name": "4g-dans-le-train",
	"version": "0.1.0",
	"description": "Carte communautaire et open source de la couverture mobile (4G/5G) le long des lignes de train en France.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://4g-dans-le-train.juulieen.fr",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/migrate.ts",
		"data:sncf": "bun run scripts/import-sncf-lines.ts",
		"data:arcep": "bun run scripts/import-arcep.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.9",
		"@sveltejs/kit": "^2.8.0",
		"@sveltejs/vite-plugin-svelte": "^4.0.0",
		"@types/bun": "^1.1.13",
		"@types/geojson": "^7946.0.16",
		"@vite-pwa/sveltekit": "^0.6.7",
		"drizzle-kit": "^0.28.0",
		"eslint": "^9.14.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.0",
		"globals": "^15.12.0",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.7",
		"svelte": "^5.1.0",
		"svelte-check": "^4.0.0",
		"typescript": "^5.6.3",
		"typescript-eslint": "^8.13.0",
		"vite": "^5.4.10",
		"vitest": "^2.1.4"
	},
	"dependencies": {
		"@libsql/client": "^0.14.0",
		"@turf/turf": "^7.1.0",
		"drizzle-orm": "^0.36.0",
		"h3-js": "^4.1.0",
		"maplibre-gl": "^4.7.1",
		"zod": "^3.23.8"
	}
}
