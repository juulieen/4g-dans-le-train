{
	"name": "4g-dans-le-train",
	"version": "0.1.0",
	"description": "Carte communautaire et open source de la couverture mobile (4G/5G) le long des lignes de train en France.",
	"type": "module",
	"license": "MIT",
	"homepage": "https://4g-dans-le-train.juulieen.fr",
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run scripts/migrate.ts",
		"data:sncf": "bun run scripts/import-sncf-lines.ts",
		"data:lines": "bun run scripts/import-commercial-lines.ts",
		"data:line-index": "bun run scripts/build-line-index.ts",
		"data:arcep": "bun run scripts/import-arcep.ts",
		"data:arcep-lines": "bun run scripts/build-arcep-lines.ts",
		"data:line-stats": "bun run scripts/build-line-stats.ts",
		"data:all": "bun run scripts/data-all.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/bun": "^1.1.13",
		"@types/geojson": "^7946.0.16",
		"@types/proj4": "^2.19.0",
		"7zip-min": "^3.0.1",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.14.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^15.12.0",
		"prettier": "^3.3.3",
		"prettier-plugin-svelte": "^3.2.7",
		"proj4": "^2.20.8",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.0",
		"typescript-eslint": "^8.13.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"wkx": "^0.5.0"
	},
	"dependencies": {
		"@libsql/client": "^0.14.0",
		"@protomaps/basemaps": "^5.7.2",
		"@resvg/resvg-js": "^2.6.2",
		"@turf/turf": "^7.1.0",
		"drizzle-orm": "^0.45.4",
		"h3-js": "^4.1.0",
		"maplibre-gl": "^6.16.0",
		"pmtiles": "^4.5.0",
		"satori": "^0.26.0",
		"uqr": "^0.1.3",
		"zod": "^4.6.7"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
